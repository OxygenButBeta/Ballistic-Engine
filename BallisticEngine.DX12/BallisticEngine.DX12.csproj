<Project Sdk="Microsoft.NET.Sdk">

    <!-- DirectX 12 + DXR rendering backend (DX12Migration.md). Kept a SEPARATE project — like
         BallisticEngine.Profiling.Tracy — so the Vortice native dependency never enters the core
         engine library; only the host exes that choose the DX12 backend reference it. -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\BallisticEngine.csproj" />
      <!-- Vortice.Windows: idiomatic C# DX12 + DXR. Brings Vortice.DXGI / Vortice.Direct3D
           transitively; Vortice.Dxc compiles HLSL -> DXIL in-process. -->
      <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
      <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
    </ItemGroup>

    <!-- HLSL shaders for the DX12 backend (embedded, mirroring OpenGL\Shader\Embedded\*.glsl). -->
    <ItemGroup>
      <EmbeddedResource Include="Shaders\**\*.hlsl" />
    </ItemGroup>

    <!-- FSR upscaler runtime DLLs: the loader dispatches to the upscaler provider (and uses AGS on AMD).
         They MUST sit next to the exe (the loader resolves the provider by name from its own dir). Copied
         to this project's output and flowed transitively to the referencing exe. DLLs are gitignored
         (native/README.md re-fetch script); the copy is Condition'd so a clean checkout without them still
         builds (FSR just self-disables at runtime). Framegeneration/radiancecache DLLs are NOT copied
         (unused by upscaling, ~39 MB). -->
    <ItemGroup Condition="Exists('..\native\fsr\bin\amd_fidelityfx_loader_dx12.dll')">
      <None Include="..\native\fsr\bin\amd_fidelityfx_loader_dx12.dll;..\native\fsr\bin\amd_fidelityfx_upscaler_dx12.dll;..\native\fsr\bin\amd_ags_x64.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

    <!-- Intel XeSS upscaler runtime (libxess.dll, Dx12XessUpscaler P/Invokes it). Runs an XMX path on Intel Arc
         and a DP4a fallback on any SM6.4 GPU (incl. AMD/NVIDIA), so it is NOT vendor-locked. Condition'd so a
         clean checkout without the gitignored native DLL still builds (XeSS self-disables → falls back to FSR). -->
    <ItemGroup Condition="Exists('..\native\xess\bin\libxess.dll')">
      <None Include="..\native\xess\bin\libxess.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

    <!-- NVIDIA Real-Time Denoiser (NRD.dll). Built from source (NVIDIA-RTX/NRD) via CMake+MSVC, staged here.
         Dx12NrdDenoiser P/Invokes its C-ABI core (NrdApi.cs). Condition'd so a clean checkout without the
         gitignored native DLL still builds (NRD self-disables → Aurora's own temporal accumulator runs). -->
    <ItemGroup Condition="Exists('..\native\nrd\bin\NRD.dll')">
      <None Include="..\native\nrd\bin\NRD.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

    <!-- NVIDIA DLSS Super Resolution model snippet (nvngx_dlss.dll). The NGX CORE loader (nvngx.dll) is installed
         system-wide by the NVIDIA driver, NOT shipped here; Dx12DlssUpscaler P/Invokes nvngx.dll and the core
         loads this snippet from the exe dir. On a non-NVIDIA box (or no driver) nvngx.dll is absent → the first
         P/Invoke throws → DLSS falls back to FSR. We also stage the Streamline interposer DLLs (sl.interposer.dll /
         sl.dlss.dll) for completeness, though the NGX-direct path does not load them. All Condition'd on Exists. -->
    <ItemGroup Condition="Exists('..\native\dlss\nvngx_dlss.dll')">
      <None Include="..\native\dlss\nvngx_dlss.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>
    <ItemGroup Condition="Exists('..\native\dlss\sl\bin\x64\sl.interposer.dll')">
      <None Include="..\native\dlss\sl\bin\x64\sl.interposer.dll;..\native\dlss\sl\bin\x64\sl.dlss.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

</Project>
