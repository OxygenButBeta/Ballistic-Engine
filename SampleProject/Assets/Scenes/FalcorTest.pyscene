# Sample Falcor scene (declarative subset the importer understands)
sceneBuilder.importGLTF("../Default/PH7.fbx")

camera = Camera()
camera.position = float3(0, 2, -15)
camera.target = float3(0, 0, 0)
camera.focalLength = 35.0
sceneBuilder.addCamera(camera)

sun = DirectionalLight('Sun')
sun.direction = float3(-0.3, -1.0, -0.2)
sun.intensity = float3(1.0, 0.95, 0.85)
sceneBuilder.addLight(sun)
