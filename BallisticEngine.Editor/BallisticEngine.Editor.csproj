<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\BallisticEngine.csproj" />
      <ProjectReference Include="..\BallisticEngine.Profiling.Tracy\BallisticEngine.Profiling.Tracy.csproj" />
      <!-- DX12 backend: the editor hosts a windowed DX12 swapchain + ImGui DX12 renderer when
           BALLISTIC_BACKEND=dx12 (editor->DX12, the gateway to deleting GL). Vortice flows in transitively
           like it does for the Runtime host. -->
      <ProjectReference Include="..\BallisticEngine.DX12\BallisticEngine.DX12.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Hexa.NET.ImGui" Version="2.2.7" />
    </ItemGroup>

    <ItemGroup>
      <!-- Bundled editor UI fonts (Inter UI + Lucide icons), copied next to the exe. -->
      <None Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
