# Build output (any project, any depth)
[Bb]in/
[Oo]bj/

# Regenerable asset import cache
SampleProject/Library/

# Local Claude Code session settings + private agent notes
.claude/
CLAUDE.md

# IDE / user-specific settings (Rider)
.idea/
*.DotSettings.user

# Stray build-artifact / archive / personal-run cruft
bin-altcheck/
*.rar
run-blackhollow.ps1

# ImGui editor layout persistence (per-machine)
imgui.ini

# Bistro test content (1.7 GB) — kept out of plain git until the git-lfs decision.
# Remove these lines and `git add` the folder once LFS (or plain tracking) is chosen.
# The folder lives at Assets/Bistro_v5_2/ now (was Assets/Default/Bistro_v5_2/ historically).
SampleProject/Assets/Default/Bistro_v5_2/
SampleProject/Assets/Bistro_v5_2/

# SampleProject test content — keep ONLY Assets/Default (engine default assets). Everything else under
# Assets/ (Characters, CornellBox, LightTest, SkyTest, TransparentTest, Entity Profile volumes, Temple,
# Bistro, ...) is throwaway test-project source — files stay on disk, just not tracked in git.
SampleProject/Assets/*
!SampleProject/Assets/Default/
SampleProject/Assets/Default/Bistro_v5_2/

# Local profiler tools (Tracy viewer/capture binaries; re-download from
# https://github.com/wolfpld/tracy/releases v0.11.1 — must match the Tracy-CSharp version)
Tools/Tracy/

# Native DLLs for the DX12 renderer (OIDN denoiser + FSR upscaler). Re-fetch via native/README.md.
# Headers + README stay tracked (they pin the P/Invoke contract); the big runtime DLLs/libs/exes don't.
native/**/*.dll
native/**/*.lib
native/**/*.exe
native/**/*.pdb


# Game-script build intermediates (Scripts.csproj output goes to Library\, already ignored)
SampleProject/obj/

# Vendor upscaler SDK extract trees (DLLs/headers re-fetched via README)
native/dlss/sl/
native/xess/inc/
native/xess/lib/
native/**/*.zip
