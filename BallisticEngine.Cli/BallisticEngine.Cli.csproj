<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `bal` CLI: a GL-FREE headless surface over the engine's data layer (scenes, components,
       assets) so AI agents and scripts can introspect/edit/validate a project from the command line.
       References the engine LIBRARY only (no Runtime/Editor, no OpenGL) — ComponentRegistry/
       ComponentReflection/SceneSerializer are all GL-free. JSON on stdout, honest exit codes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bal</AssemblyName>
    <RootNamespace>BallisticEngine.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BallisticEngine.csproj" />
  </ItemGroup>

</Project>
